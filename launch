#!/usr/bin/env bash
# Launch Instagraph: rebuild the frontend if it is out of date, then start the backend.
#
#   ./launch              serve on http://127.0.0.1:8000 (this computer only)
#   ./launch --lan        serve on the local network too (phones, other computers)
#   ./launch --port 9000  use another port (also: PORT=9000 ./launch)
#   ./launch --rebuild    force a frontend rebuild
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FRONTEND="$ROOT/frontend"
BACKEND="$ROOT/backend"
DIST_INDEX="$FRONTEND/dist/index.html"

MODE="local"
PORT="${PORT:-8000}"
FORCE_BUILD=0

usage() { sed -n '2,8s/^# \{0,1\}//p' "$0"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l | --lan | lan) MODE="lan" ;;
    --local | local) MODE="local" ;;
    -p | --port)
      [[ $# -ge 2 ]] || { echo "error: $1 needs a value" >&2; exit 2; }
      PORT="$2"
      shift
      ;;
    --port=*) PORT="${1#*=}" ;;
    -r | --rebuild) FORCE_BUILD=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "error: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

[[ "$PORT" =~ ^[0-9]+$ ]] || { echo "error: port must be a number, got '$PORT'" >&2; exit 2; }

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }

# --- Prerequisites --------------------------------------------------------------------
if [[ ! -x "$BACKEND/.venv/bin/uvicorn" ]]; then
  echo "error: backend venv not found. Run 'make setup' first." >&2
  exit 1
fi

if [[ ! -d "$FRONTEND/node_modules" ]] ||
  [[ "$FRONTEND/package-lock.json" -nt "$FRONTEND/node_modules/.package-lock.json" ]]; then
  say "Installing frontend dependencies (npm install)…"
  (cd "$FRONTEND" && npm install)
  FORCE_BUILD=1
fi

# --- Frontend build check -------------------------------------------------------------
# The build is stale if any file that feeds into it is newer than dist/index.html.
frontend_inputs() {
  find "$FRONTEND/src" "$FRONTEND/public" -type f -print 2>/dev/null
  for f in index.html package.json package-lock.json vite.config.ts tailwind.config.js \
    postcss.config.js tsconfig*.json; do
    [[ -e "$FRONTEND/$f" ]] && echo "$FRONTEND/$f"
  done
  return 0
}

reason=""
if [[ $FORCE_BUILD -eq 1 ]]; then
  reason="rebuild requested"
elif [[ ! -f "$DIST_INDEX" ]]; then
  reason="no build found"
else
  newer="$(frontend_inputs | while IFS= read -r f; do
    [[ "$f" -nt "$DIST_INDEX" ]] && { echo "${f#"$FRONTEND/"}"; break; }
  done || true)"
  [[ -n "$newer" ]] && reason="$newer changed since the last build"
fi

if [[ -n "$reason" ]]; then
  say "Building frontend ($reason)…"
  (cd "$FRONTEND" && npm run build)
else
  say "Frontend build is up to date."
fi

# --- Network settings -----------------------------------------------------------------
if [[ "$MODE" == "lan" ]]; then
  # Every non-loopback IPv4 address of this machine, plus its hostname(s).
  mapfile -t ips < <(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' || true)
  host_name="$(hostname 2>/dev/null || true)"
  allowed=("${ips[@]}")
  if [[ -n "$host_name" ]]; then
    allowed+=("$host_name" "$host_name.local")
  fi
  # Keep any hosts the user already allowed.
  [[ -n "${INSTAGRAPH_ALLOWED_HOSTS:-}" ]] && allowed+=("$INSTAGRAPH_ALLOWED_HOSTS")

  export INSTAGRAPH_HOST="0.0.0.0"
  export INSTAGRAPH_ALLOWED_HOSTS="$(IFS=,; echo "${allowed[*]}")"

  warn "LAN mode: anyone on your network who can reach this computer can see your messages."
  say "Open on this computer:  http://127.0.0.1:$PORT"
  if [[ ${#ips[@]} -eq 0 ]]; then
    warn "Could not find a network address for this computer."
  fi
  for ip in "${ips[@]}"; do
    say "Open on other devices:  http://$ip:$PORT"
  done

  # WSL2 in the default NAT mode only has an internal 172.16–31.x address that other
  # devices can't reach.
  if grep -qi microsoft /proc/version 2>/dev/null; then
    if [[ ${#ips[@]} -eq 0 ]] || printf '%s\n' "${ips[@]}" | grep -qE '^172\.(1[6-9]|2[0-9]|3[01])\.'; then
      warn "WSL detected: other devices may not reach a 172.x address. Enable mirrored"
      warn "networking (networkingMode=mirrored in %UserProfile%\\.wslconfig, then 'wsl --shutdown')"
      warn "and allow port $PORT in Windows Firewall."
    fi
  fi
else
  export INSTAGRAPH_HOST="127.0.0.1"
  say "Open http://127.0.0.1:$PORT"
fi

# --- Start ----------------------------------------------------------------------------
cd "$BACKEND"
exec .venv/bin/uvicorn instagraph.main:app --host "$INSTAGRAPH_HOST" --port "$PORT"
